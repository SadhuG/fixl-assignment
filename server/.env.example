# Required
MONGODB_URI=mongodb://127.0.0.1:27017/taskhive
JWT_SECRET=replace-with-64-random-characters-generated-by-openssl-rand-hex-32
CLIENT_ORIGIN=http://localhost:5173
# Optional
PORT=4000
NODE_ENV=development
BCRYPT_COST=12
# 1 locally / behind one proxy; 2 in production (Vercel rewrite -> Render)
TRUST_PROXY=1
# Password given to every seeded demo user
SEED_PASSWORD=TaskHive#2026
